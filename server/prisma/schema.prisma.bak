generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Owner {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // hashed
  name      String
  createdAt DateTime @default(now())
}

model Zone {
  id             Int       @id @default(autoincrement())
  code           String    @unique // A, B, C, VIP
  name           String    // Zone A – หน้าเวที
  seatsPerTable  Int       // 4 or 6
  totalTables    Int
  minSpend       Float
  extraTableCost Float
  color          String    // hex
  bookings       Booking[]
}

model Booking {
  id            Int      @id @default(autoincrement())
  zoneId        Int
  zone          Zone     @relation(fields: [zoneId], references: [id])
  guestCount    Int
  extraTable    Boolean  @default(false)
  totalAmount   Float
  depositAmount Float
  
  // Customer info
  customerName  String
  customerPhone String
  lineId        String?
  arrivalTime   String
  occasion      String?  // birthday, anniversary, etc.
  note          String?
  
  // Status
  status        String   @default("pending") // pending, confirmed, checked-in, completed, cancelled
  qrCode        String   @unique
  
  // Payment
  paymentMethod String?  // transfer, promptpay, credit
  paymentStatus String   @default("unpaid") // unpaid, deposit, paid
  
  // Timestamps
  bookingDate   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
