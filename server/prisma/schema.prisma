generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Owner {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Zone {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  name           String
  seatsPerTable  Int
  totalTables    Int
  minSpend       Float
  extraTableCost Float
  color          String
  bookings       Booking[]
  tables         Table[]
}

model Table {
  id            Int            @id @default(autoincrement())
  number        String         @unique
  x             Float          @default(0)
  y             Float          @default(0)
  status        String         @default("active")
  zoneId        Int
  bookings      Booking[]
  bookingTables BookingTable[]
  holds         TableHold[]
  zone          Zone           @relation(fields: [zoneId], references: [id])
}

// Temporary hold placed on a table the moment a customer selects it, so no one
// else can pick the same table while they finish the booking flow. Holds expire
// after AppConfig.holdMinutes; a background job + lazy reads release stale ones.
model TableHold {
  id          Int      @id @default(autoincrement())
  tableId     Int
  bookingDate DateTime
  sessionId   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  table       Table    @relation(fields: [tableId], references: [id])

  @@index([tableId])
  @@index([expiresAt])
}

model Booking {
  id               Int      @id @default(autoincrement())
  zoneId           Int
  tableId          Int?
  guestCount       Int
  extraTable       Boolean  @default(false)
  totalAmount      Float
  depositAmount    Float
  customerName     String
  customerPhone    String
  lineId           String?
  arrivalTime      String?
  occasion         String?
  note             String?
  status           String   @default("pending")
  qrCode           String   @unique
  idempotencyKey   String?  @unique
  paymentMethod    String?
  paymentStatus    String   @default("unpaid")
  slipImageUrl     String?
  slipRejectReason String?
  bookingDate      DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  table            Table?   @relation(fields: [tableId], references: [id])
  zone             Zone     @relation(fields: [zoneId], references: [id])
  tables           BookingTable[]
}

// Every table on a booking. A reservation can span several tables, so `tables` is the
// authoritative set — availability checks must read it, never Booking.tableId alone.
// Booking.tableId is kept as the primary (first) table purely so older read paths and
// the QR scanner keep showing something sensible; it is always tables[0].
model BookingTable {
  id        Int     @id @default(autoincrement())
  bookingId Int
  tableId   Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  table     Table   @relation(fields: [tableId], references: [id])

  @@unique([bookingId, tableId])
  @@index([tableId])
}

model AppConfig {
  id                   Int     @id @default(autoincrement())
  isBookingOpen        Boolean @default(true)
  openTime             String  @default("18:00")
  closeTime            String  @default("02:00")
  isBookingFeeRequired Boolean @default(true)
  holdMinutes          Int     @default(15)
  bankName             String?
  bankAccountNumber    String?
  bankAccountName      String?
  promptPayNumber      String?
}

model Fixture {
  id       Int     @id @default(autoincrement())
  label    String
  sublabel String?
  icon     String?
  x        Float
  y        Float
  w        Float
  h        Float
  style    String  @default("default")
  vertical Boolean @default(false)
  rotation Int?
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model SpecialDate {
  id              Int      @id @default(autoincrement())
  date            DateTime @unique
  name            String
  description     String?
  priceType       String   @default("normal")
  depositRequired Boolean  @default(true)
  depositAmount   Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
