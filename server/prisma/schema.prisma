generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Owner {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Zone {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  name           String
  seatsPerTable  Int
  totalTables    Int
  minSpend       Float
  extraTableCost Float
  color          String
  bookings       Booking[]
  tables         Table[]
}

model Table {
  id       Int       @id @default(autoincrement())
  number   String    @unique
  x        Float     @default(0)
  y        Float     @default(0)
  status   String    @default("active")
  zoneId   Int
  bookings Booking[]
  zone     Zone      @relation(fields: [zoneId], references: [id])
}

model Booking {
  id               Int      @id @default(autoincrement())
  zoneId           Int
  tableId          Int?
  guestCount       Int
  extraTable       Boolean  @default(false)
  totalAmount      Float
  depositAmount    Float
  customerName     String
  customerPhone    String
  lineId           String?
  arrivalTime      String?
  occasion         String?
  note             String?
  status           String   @default("pending")
  qrCode           String   @unique
  paymentMethod    String?
  paymentStatus    String   @default("unpaid")
  slipImageUrl     String?
  slipRejectReason String?
  bookingDate      DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  table            Table?   @relation(fields: [tableId], references: [id])
  zone             Zone     @relation(fields: [zoneId], references: [id])
}

model AppConfig {
  id                   Int     @id @default(autoincrement())
  isBookingOpen        Boolean @default(true)
  openTime             String  @default("18:00")
  closeTime            String  @default("02:00")
  isBookingFeeRequired Boolean @default(true)
  bankName             String?
  bankAccountNumber    String?
  bankAccountName      String?
  promptPayNumber      String?
}

model Fixture {
  id       Int     @id @default(autoincrement())
  label    String
  sublabel String?
  icon     String?
  x        Float
  y        Float
  w        Float
  h        Float
  style    String  @default("default")
  vertical Boolean @default(false)
  rotation Int?
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model SpecialDate {
  id              Int      @id @default(autoincrement())
  date            DateTime @unique
  name            String
  description     String?
  priceType       String   @default("normal")
  depositRequired Boolean  @default(true)
  depositAmount   Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
